@startuml
!theme plain
skinparam shadowing false
left to right direction

title Deployment View - Docker Compose (Current)

node "Developer Machine" {
  node "Docker Engine" {
    node "frontend container\n:3000" as Frontend
    node "api-gateway container\n:8000" as Gateway

    node "auth-service container\n:8001" as Auth
    node "user-service container\n:8002->8000" as UserService
    node "product-service container\n:8003" as Product

    database "auth-postgres\n:5433->5432" as AuthDB
    database "user-postgres\n:5432->5432" as UserDB
    database "redis\n:6379" as Redis
    queue "rabbitmq\n:5672 / :15672" as MQ
  }
}

Frontend --> Gateway : VITE_API_URL
Gateway --> Auth : /auth/
Gateway --> UserService : /users/, /internal/
Gateway --> Product : /products/

Auth --> AuthDB
Auth --> Redis
Auth --> MQ

UserService --> UserDB
UserService --> MQ

Product --> UserDB
Product --> Redis
Product --> UserService

@enduml
