@startuml
!theme plain
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 11
top to bottom direction

title Vista N-Tier — AICart (Jun 2026)

package "Tier 1 — Cliente" {
  component "Browser" as Browser
  component "Frontend\nNext.js 14 · :3000" as Frontend
}

package "Tier 2 — API Gateway" {
  component "NGINX\n:8000 (HTTP) · :8443 (HTTPS)" as Gateway
}

package "Tier 3 — Servicios" {
  component "auth-service\n:8001" as Auth
  component "auth-service-cold\n:8002" as AuthCold
  component "spare-coordinator" as Coord
  component "user-service\n:8000" as UserSvc
  component "product-service\n:8003" as ProductSvc
  component "order-service\n:8004" as OrderSvc
  component "ai-service\n:8005" as AISvc
}

package "Tier 4 — Datos" {
  database "auth-postgres" as AuthDB
  database "user-postgres" as UserDB
  database "product-postgres" as ProductDB
  database "order-postgres" as OrderDB
  database "Redis" as Redis
  queue "RabbitMQ" as MQ
  cloud "Groq API" as Groq
}

Browser  --> Frontend  : HTTPS
Frontend --> Gateway   : REST / JSON

Gateway --> Auth       : /auth/* (primary)
Gateway --> AuthCold   : /auth/* (backup)
Gateway --> UserSvc    : /users/*
Gateway --> ProductSvc : /products/*
Gateway --> OrderSvc   : /orders/*
Gateway --> AISvc      : /ai/*

Coord --> Auth     : GET /health
Coord --> AuthCold : POST /activate

Auth        --> AuthDB
Auth        --> Redis
Auth        --> MQ
AuthCold    --> AuthDB
UserSvc     --> UserDB
UserSvc     --> MQ
ProductSvc  --> ProductDB
ProductSvc  --> Redis
ProductSvc  --> MQ
OrderSvc    --> OrderDB
OrderSvc    --> MQ
OrderSvc    --> ProductSvc
AISvc       --> Redis
AISvc       --> UserSvc
AISvc       --> ProductSvc
AISvc       --> Groq

@enduml
