@startuml
!theme plain
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 10
skinparam packageStyle frame
left to right direction

title Vista de Descomposición — Dominios de Negocio AICart (Jun 2026)

package "Identidad\n(auth-service)" #LightBlue {
  component "Registro y autenticación\nJWT · bcrypt · sesiones Redis" as AuthResp
  component "User\n{id, email, password_hash}" as AuthEntity
}

package "Perfil de Usuario\n(user-service)" #LightGreen {
  component "Gestión de perfiles\ny direcciones de envío" as UserResp
  component "UserProfile · Address" as UserEntity
}

package "Catálogo e Inventario\n(product-service)" #LightYellow {
  component "Productos · categorías\nreviews · galería · stock" as ProductResp
  component "Product · Category\nProductReview · StockReservation" as ProductEntity
}

package "Comercio / Órdenes\n(order-service)" #LightSalmon {
  component "Ciclo de vida de órdenes\ncancelación · timeout" as OrderResp
  component "Order · OrderItem\nOrderStatus" as OrderEntity
}

package "Asistente IA\n(ai-service)" #Plum {
  component "Chat con contexto\nrecomendaciones · rate limiting" as AIResp
  component "ConversationHistory\n(Redis)" as AIEntity
}

package "Infraestructura Transversal" #LightGray {
  component "API Gateway (NGINX)\nrouting · TLS · CORS" as GW
  component "Alta Disponibilidad\nauth cold-spare · watchdog" as HA
  component "RabbitMQ\nevents · saga" as MB
  component "Redis\nsesiones · caché · rate-limit" as Cache
}

GW --> AuthResp    : /auth/*
GW --> UserResp    : /users/*
GW --> ProductResp : /products/*
GW --> OrderResp   : /orders/*
GW --> AIResp      : /ai/*
HA --> AuthResp    : watchdog

AuthResp    -->> UserResp    : AUTH_USER_REGISTERED
OrderResp   -->> ProductResp : ORDER_CREATED
ProductResp -->> OrderResp   : STOCK_RESERVED /\nSTOCK_UNAVAILABLE
OrderResp    --> ProductResp : consulta stock (HTTP)
AIResp       --> ProductResp : lee catálogo
AIResp       --> UserResp    : lee perfil

@enduml
