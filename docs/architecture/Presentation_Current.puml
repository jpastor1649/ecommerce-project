@startuml
!theme plain
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 10
left to right direction

title Vista de Presentación — Frontend Next.js 14 App Router (Jun 2026)

actor "Usuario\n(autenticado)" as User

package "frontend/src" {

  component "middleware.js\n(route guards:\n/dashboard/* → / sin token\n/ y /register → /dashboard si autenticado)" as Middleware

  package "app/ (App Router)" {
    component "layout.js + page.js\n(root: → LoginPage)" as AppRoot
    component "register/page.js\n(→ RegisterPage)" as RouteRegister
    component "dashboard/layout.js\n(SSR /auth/me via API_SERVER_URL)" as DashboardLayout
    component "dashboard/products/page.js" as RouteProducts
    component "dashboard/products/[productId]/page.js" as RouteProductDetail
    component "dashboard/orders/page.js" as RouteOrders
    component "dashboard/my-products/page.js" as RouteMyProducts
    component "dashboard/profile/page.js" as RouteProfile
  }

  package "widgets/dashboard" {
    component "DashboardLayout.jsx\n(shell de navegación)" as DashboardWidget
    component "ChatWidget.jsx\n(chat IA, POST /ai/chat/)" as ChatWidget
  }

  package "components/ + pages/ (feature screens)" {
    component "auth/LoginPage\nauth/RegisterPage" as AuthPages
    component "catalog/ProductCatalogPage\ncatalog/ProductDetailPage" as CatalogPages
    component "seller/MyProductsPage" as SellerPages
    component "orders/OrdersPage" as OrderPages
    component "profile/UserProfilePage" as ProfilePages
  }

  package "shared" {
    component "config/api.js\n(NEXT_PUBLIC_API_URL)" as ApiConfig
    component "lib/auth.js\n(cookie auth_token SameSite=Strict)" as AuthLib
    component "lib/http.js\n(fetchWithGatewayRetry\nbackoff 500ms × 3)" as HttpLib
    component "utils/api.js\n(fetchJson, fetchJsonWithAuth\nfetchUserLabel, fetchUserLabels)" as ApiUtils
    component "hooks/\n(useProductDetail, useProfileForm,\nuseAddressForm, useProductActivity,\nuseFormHandler, useUserProfile)" as Hooks
  }
}

component "API Gateway\nhttps://localhost:8443\n(CSR)\nhttp://api-gateway:8000\n(SSR interno)" as Gateway

User --> Middleware : navegación browser
Middleware --> AppRoot

AppRoot --> AuthPages         : /
AppRoot --> RouteRegister     : /register
AppRoot --> DashboardLayout   : /dashboard/*

DashboardLayout --> DashboardWidget
DashboardWidget --> ChatWidget
DashboardLayout --> RouteProducts
DashboardLayout --> RouteProductDetail
DashboardLayout --> RouteOrders
DashboardLayout --> RouteMyProducts
DashboardLayout --> RouteProfile

RouteProducts --> CatalogPages
RouteProductDetail --> CatalogPages
RouteOrders --> OrderPages
RouteMyProducts --> SellerPages
RouteProfile --> ProfilePages

AuthPages --> HttpLib
CatalogPages --> HttpLib
SellerPages --> HttpLib
OrderPages --> HttpLib
ProfilePages --> HttpLib
ChatWidget --> HttpLib

HttpLib --> ApiConfig
HttpLib --> ApiUtils
HttpLib --> AuthLib
Hooks --> ApiUtils
Hooks --> AuthLib

ApiConfig --> Gateway
ApiUtils --> Gateway
DashboardLayout --> Gateway : SSR (API_SERVER_URL)

@enduml
