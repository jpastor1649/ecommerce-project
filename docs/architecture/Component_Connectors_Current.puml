@startuml
!theme plain
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 11
top to bottom direction

title Vista de Componentes y Conectores — AICart (Jun 2026)

actor "Usuario" as User

component "Frontend\nNext.js 14\nClient Port: 3000" as Frontend

component "RP Gateway\nNginx\nHTTP :8000 → HTTPS :8443\nRate Limiting / CORS / TLS" as Gateway

User --> Frontend : HTTPS
Frontend --> Gateway : REST / JSON

package "Subnet B — Servicios Privados" {

  component "auth-service\nFastAPI\nClient Port: 8001\nJWT + bcrypt" as Auth
  component "auth-service-cold\nFastAPI spare\nPort: 8002" as AuthCold
  component "spare-coordinator\nWatchdog\n(polling /health)" as Coord

  component "user-service\nFastAPI\nClient Port: 8000" as UserSvc

  component "product-service\nFastAPI\nClient Port: 8003" as ProductSvc

  component "order-service\nFastAPI\nClient Port: 8004" as OrderSvc

  component "ai-service\nFastAPI\nClient Port: 8005" as AISvc

}

cloud "GROQ API\n(Llama 3.1)" as Groq

database "auth-postgres\nData Access Port" as AuthDB
database "user-postgres\nData Access Port" as UserDB
database "product-postgres\nData Access Port" as ProductDB
database "order-postgres\nData Access Port" as OrderDB

queue "RabbitMQ\nPort: 5672 / 15672" as MQ
database "Redis\nCache: 6379" as Redis

' Gateway routing
Gateway --> Auth      : /auth/* (primary)
Gateway --> AuthCold  : /auth/* (backup failover)
Gateway --> UserSvc   : /users/* /internal/*
Gateway --> ProductSvc: /products/*
Gateway --> OrderSvc  : /orders/* → /api/v1/orders/*
Gateway --> AISvc     : /ai/* → /api/v1/* (limit_req 2r/s)

' Cold-spare
Coord --> Auth      : GET /health (cada 3s)
Coord --> AuthCold  : POST /activate (tras 3 fallos)

' Auth
Auth --> AuthDB : SQL — users
Auth --> Redis  : token blacklist / sessions
Auth --> MQ     : AUTH_USER_REGISTERED

' Auth cold (mismas dependencias, rol spare)
AuthCold --> AuthDB : SQL — users (spare)
AuthCold --> Redis  : token blacklist

' User service
UserSvc --> UserDB : SQL — profiles + addresses
MQ --> UserSvc     : user_profile_create_queue\n(consumer thread)

' Product service
ProductSvc --> ProductDB : SQL — products + categories\n+ reviews + images + reservations
ProductSvc --> Redis     : seller/category cache (TTL 900s)
MQ --> ProductSvc        : order.created / order.cancelled\n(ProductSagaConsumer)
ProductSvc --> MQ        : STOCK_RESERVED / STOCK_UNAVAILABLE\n(commerce.saga exchange)

' Order service
OrderSvc --> OrderDB   : SQL — orders + items\n+ processed_events
OrderSvc --> MQ        : ORDER_CREATED\n(commerce.saga exchange)
MQ --> OrderSvc        : stock.reserved / stock.unavailable\n(OrderSagaConsumer)
OrderSvc --> ProductSvc: GET /internal/products/* (HTTP)

' AI service
AISvc --> Redis     : historial conversacional\n+ rate-limit sliding window
AISvc --> UserSvc   : contexto del usuario
AISvc --> ProductSvc: catálogo de productos
AISvc --> Groq      : inferencia LLM

@enduml
